TEXT 536 -48 Left 2 !* NAND2 VTC \n.param Wn=3u\n.step param Wp list 0.5u 0.8u 1u 1.6u 2.0u 3.2u 4.0u\n \nVdd vdd 0 3.3\nVb b 0 3.3            ; hold B = VDD\nVa a 0 DC 0         \n \n* PMOS\nM1a vout a vdd vdd Pmod W={Wp} L=0.6u\nM2a vout b vdd vdd Pmod W={Wp} L=0.6u\n \n* NMOS\nM3a vout a n1 0 Nmod W={Wn} L=0.6u\nM4a n1   b  0 0   Nmod W={Wn} L=0.6u\n \n* models\n.model Nmod NMOS (LEVEL=1 VTO=0.7 KP=200u LAMBDA=0.02)\n.model Pmod PMOS (LEVEL=1 VTO=-0.7 KP=80u LAMBDA=0.02)\n \n* DC sweep Va from 0 to Vdd\n.dc Va 0 3.3 0.005\n \n* measure A (VIN when Vout = VOH) and B (VIN when Vout = VOL)\n.meas DC A FIND V(a) WHEN V(vout)=3.0\n.meas DC B FIND V(a) WHEN V(vout)=0.3\n \n* compute margins (per step results will be printed)\n.meas DC NML PARAM='A-0.3'\n.meas DC NMH PARAM='3.0-B'\n.meas DC NM  PARAM='min(NML,NMH)'\n \n.end
